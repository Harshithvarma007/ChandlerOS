# Copy to .env and fill in real values. Never commit the real .env (already
# gitignored). All providers/models here have $0/month free tiers as of
# writing — see app/router_config.json for which models are active.

GEMINI_API_KEY=
GEMINI_PROJECT_NAME=
GEMINI_PROJECT_NUMBER=
GROQ_API_KEY=

# Optional, HTTP-layer only (app/main.py) — comma-separated CORS origins.
# Defaults to the production portfolio domain + a local dev port if unset.
# ALLOWED_ORIGINS=https://harshithvarma.dev,https://www.harshithvarma.dev,http://localhost:5173

# Optional — set to 1 only when main.py runs behind a reverse proxy you
# trust to set (and strip any client-supplied) X-Forwarded-For itself.
# TRUST_PROXY=1
