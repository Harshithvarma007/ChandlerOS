{
  "phase": "10 - Emotional Analysis",
  "methodology": {
    "sampling": "Systematic stratified sample: response_word_count split into 3 terciles over the full dataset (cutoffs computed on all N rows), rows sorted by id within each tercile, every 5th row selected (systematic sampling within stratum).",
    "tercile_cutoffs_word_count": {
      "short_max": 5,
      "medium_max": 10
    },
    "sample_size": 508,
    "full_dataset_size": 2535,
    "categories_used": [
      "happiness",
      "excitement",
      "sadness",
      "frustration",
      "anger",
      "embarrassment",
      "awkwardness",
      "uncertainty",
      "fear",
      "vulnerability",
      "seriousness",
      "celebration",
      "disappointment",
      "confusion"
    ],
    "measurement_method": "context_raw classified into 1+ emotional-context categories via curated regex/keyword lexicons (semantic judgment operationalized as lexicon rules; lexicons were calibrated by checking match-rate distributions against the full dataset to avoid degenerate over/under-matching before scoring the sample). response_raw scored for each behavior dimension via lexical-marker presence (0/1 per response), averaged per matched context category. verbosity_avg_word_count uses response_word_count directly (OBSERVED). directness = assertion-marker rate minus a discount for hedge-marker rate, clipped to [0,1]. conversational_energy is a composite of exclamation-mark rate, average word count, and humor-marker rate.",
    "labeling_note": "A response's context can match more than one emotional-context category (multi-label); rows with no lexicon hits default to 'neutrality'. Sarcasm/humor/self-deprecation are lexically detected on explicit surface markers only; irony and structural (non-lexical) jokes are under-counted by construction, so these rates should be read as conservative lower bounds, not ceilings.",
    "tag_legend": "OBSERVED = directly counted from data fields. INFERRED = derived by applying the stated lexicon/heuristic rules to text. HYPOTHESIS = interpretive claim beyond what the counts alone establish."
  },
