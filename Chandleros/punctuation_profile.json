    "rhetorical_questions": {
      "claim": "Tag-question / rhetorical-lexical-cue patterns account for a measurable minority of all question-containing responses, indicating question marks are frequently used for rhetorical effect rather than literal information-seeking.",
      "evidence": {
        "question_containing_responses": 741,
        "matching_tag_question_or_rhetorical_cue": 40,
        "conditional_rate": {
          "count": 40,
          "total": 741,
          "rate": 0.054,
          "pct": 5.4
        }
      }
    },
    "conversational_rhythm": {
      "claim": "Comma rate per 1000 chars correlates with clause count per sentence (both proxies for embedded/compound structure), suggesting commas are the dominant rhythm-pacing device inside a Chandler turn (far more frequent than semicolons/colons, which are used for weightier structural breaks).",
      "evidence": {
        "comma_total_rate_per_1000_char": 16.772,
        "semicolon_total_rate_per_1000_char": 0.058,
        "colon_total_rate_per_1000_char": 0.115,
        "mean_clauses_per_sentence": 1.554
      }
    },
    "humor": {
      "tag": "HYPOTHESIS",
      "claim": "Humor cannot be directly measured from punctuation alone; as an indirect proxy, short-punchline responses (see sentence_rhythm.json) co-occur with terminal '.' or '!' far more than with '?', suggesting punchlines are delivered as flat statements/exclamations rather than questions.",
