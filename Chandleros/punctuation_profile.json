          "rate": 0.0205,
          "pct": 2.05
        }
      }
    },
    "interruption": {
      "claim": "Dash usage (em-dash/double-hyphen) strongly co-occurs with the interruption-marker flag by construction (same surface cue), and independently, most dash-containing responses place the dash away from sentence-final position less often than ellipsis does at sentence-final position.",
      "evidence": {
        "responses_with_dash": 6,
        "responses_with_dash_and_interruption_flag": 6,
        "conditional_rate": {
          "count": 6,
          "total": 6,
          "rate": 1.0,
          "pct": 100.0
        }
      }
    },
    "emphasis": {
      "claim": "Exclamation marks are disproportionately concentrated in short responses (<=6 words), consistent with punchy/emphatic delivery rather than being spread evenly across long explanatory turns.",
