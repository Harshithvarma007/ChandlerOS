  "punctuation_function_analysis": {
    "tag": "INFERRED",
    "description": "Each claim below is backed by a measured co-occurrence or conditional rate computed from the dataset (see 'evidence'), not asserted from intuition.",
    "hesitation": {
      "claim": "Ellipsis usage co-occurs with unfinished/trailing constructions, consistent with a hesitation/trailing-off function.",
